# Gradle
.gradle/
build/

# run-paper test server (regenerated by ./gradlew runServer).
# eula.txt is kept so a fresh clone boots without redoing setup. server.properties is NOT
# tracked — Paper rewrites it on boot and injects a generated management-server-secret.
run/*
!run/eula.txt

# Node (test bot harness). package-lock.json IS tracked, so everyone installs the same
# mineflayer and a bot that works here works there.
node_modules/

# IDE
.idea/
*.iml
bin/
out/
.classpath
.project
.settings/
# The rest of .vscode/ is shared (debug config, build tasks, extension hints); this one file
# holds absolute JDK paths and so belongs to whichever machine wrote it.
.vscode/settings.json

# Agent scratch notes, not documentation
CLAUDE.md

# JVM crash and replay dumps, which land wherever the server was started from
hs_err_pid*.log
replay_pid*.log

# OS
Thumbs.db
.DS_Store
